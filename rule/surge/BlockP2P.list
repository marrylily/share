# =======================================================
# Surge P2P / PCDN / STUN / BT 综合阻断规则集 (Rule-Set 格式)
# 引用方式：RULE-SET,本地路径或URL,REJECT-DROP
# =======================================================

# --- [通用/暴力特征兜底] ---
DOMAIN-KEYWORD,p2p
DOMAIN-KEYWORD,pcdn
DOMAIN-KEYWORD,mcdn
DOMAIN-KEYWORD,p2p-pc
# 常见 HTTP Tracker 特征 (仅在非加密请求或开启 MitM 时生效)
URL-REGEX,.*live.*p2p.*
URL-REGEX,announce\.php\?passkey=

# --- [全局 HTTPDNS 拦截 (防 App 绕过系统 DNS 硬编码调度 PCDN)] ---
DOMAIN-KEYWORD,httpdns
DOMAIN,dig.bdurl.net
DOMAIN,dig.snssdk.com
DOMAIN,httpdns.alicdn.com
DOMAIN,httpdns-api.aliyuncs.com
DOMAIN,httpdns-sc.aliyuncs.com
DOMAIN,httpdns.bilivideo.com
DOMAIN,httpdns.c.cdnhwc2.com
DOMAIN,httpdns.meituan.com
DOMAIN,httpdns.n.netease.com
DOMAIN,httpdns.ocloud.oppomobile.com
DOMAIN,httpdns.push.oppomobile.com
DOMAIN,httpdns.volcengineapi.com
DOMAIN,httpdns.zybang.com
DOMAIN,dns.jd.com
DOMAIN,dns.weixin.qq.com.cn
DOMAIN,dns.weibo.cn

