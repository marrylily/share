# --- [高危 P2P/STUN 端口阻断] ---
# 建议仅阻断 UDP 协议的 STUN 端口，减少对普通 TCP 业务的误伤
AND,((PROTOCOL,UDP), (DEST-PORT,3478))
AND,((PROTOCOL,UDP), (DEST-PORT,3479))
AND,((PROTOCOL,UDP), (DEST-PORT,5349))
AND,((PROTOCOL,UDP), (DEST-PORT,5350))
AND,((PROTOCOL,UDP), (DEST-PORT,19302))
DEST-PORT,10000

# --- [PT/BT 下载与 Tracker 通用特征] ---
# 已移除 DOMAIN-KEYWORD,peer 防止日常网页误伤
DOMAIN-KEYWORD,torrent
DOMAIN-KEYWORD,tracker
DOMAIN-KEYWORD,announce
DEST-PORT,6881-6889
DEST-PORT,51413
DEST-PORT,22471

