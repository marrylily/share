const buildList = (...elements) => elements.flat().filter(Boolean);

function buildBaseLists({ landing, lowCost, countryGroupNames }) {
  const defaultSelector = buildList(
    PROXY_GROUPS.AUTO,
    PROXY_GROUPS.FALLBACK,
    landing && PROXY_GROUPS.LANDING,
    countryGroupNames,
    lowCost && PROXY_GROUPS.LOW_COST,
    PROXY_GROUPS.MANUAL,
    "DIRECT"
  );

  const defaultProxies = buildList(
    PROXY_GROUPS.SELECT,
    PROXY_GROUPS.AUTO,
    countryGroupNames,
    lowCost && PROXY_GROUPS.LOW_COST,
    PROXY_GROUPS.MANUAL,
    PROXY_GROUPS.DIRECT
  );

  // GitHub 专有代理组：优先走代理与自动测速，绝不将 DIRECT 放在首位
  const defaultGithubProxies = buildList(
    PROXY_GROUPS.SELECT,
    PROXY_GROUPS.AUTO,
    countryGroupNames,
    PROXY_GROUPS.MANUAL,
    PROXY_GROUPS.DIRECT
  );

  const defaultProxiesDirect = buildList(
    PROXY_GROUPS.DIRECT,
    countryGroupNames,
    lowCost && PROXY_GROUPS.LOW_COST,
    PROXY_GROUPS.SELECT,
    PROXY_GROUPS.MANUAL
  );

  const defaultFallback = buildList(
    landing && PROXY_GROUPS.LANDING,
    countryGroupNames,
    lowCost && PROXY_GROUPS.LOW_COST,
    PROXY_GROUPS.MANUAL,
    "DIRECT"
  );

  return { defaultProxies, defaultGithubProxies, defaultProxiesDirect, defaultSelector, defaultFallback };
}

